# Copy to /etc/ptterm.env and edit, then: systemctl restart ptterm
PTT_ADDR=:2222

# Optional admin keys (authorized_keys format). Must be readable by the
# service: put it in /etc/ptterm/ with mode 0644.
# PTT_ADMIN_KEYS=/etc/ptterm/admins.pub

# Optional custom rooms (first one is the lobby):
# PTT_ROOMS=general:大厅 Lobby,chinese:中文频道,english:English,technology:技术,anonymous:随便聊

# Any other flags:
PTT_ARGS=-history 50 -history-ttl 1h -max-per-ip 3 -idle-timeout 30m
