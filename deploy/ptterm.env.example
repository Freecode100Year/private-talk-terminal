# /etc/ptterm.env — install.sh creates this for you. After editing:
#   systemctl restart ptterm
# Full flag list: ptterm -h

PTT_ADDR=:2222

# Counts-only health endpoint (used by "ptterm-ctl status"). Keep it on localhost.
PTT_HEALTH_ADDR=127.0.0.1:2223

# Soft memory target for the Go runtime; install.sh sets ~60% of RAM.
GOMEMLIMIT=600MiB

# Admin keys (authorized_keys format), readable by the service (mode 0644).
#PTT_ADMIN_KEYS=/etc/ptterm/admins.pub

# Public rooms, first one is the lobby.
#PTT_ROOMS=general:大厅 Lobby,chinese:中文频道,english:English,technology:技术,anonymous:随便聊

# Extra welcome lines shown on connect.
#PTT_MOTD=/etc/ptterm/motd.txt

# Any other flags.
PTT_ARGS=-history 50 -history-ttl 1h -max-per-ip 3 -idle-timeout 1h
